# ---------------------------------------------------------------- 构建产物
build/
build-*/
*.o
*.d
*.a
*.so
*.exe
compile_commands.json
Testing/

# ---------------------------------------------------------------- 外部源码
# 完整 WT 克隆 + 构建产物（scripts/wt_tools.sh 生成；可随时重拉，不入库）
external/
# 旧版 fetch 脚本留下的空壳目录，已废弃，留着也不影响（lib_wt.sh 会跳过无效树）
third_party/wt/

# ★ 但真头文件必须入库：它是 ABI 合同，克隆下来就要能 make probe。
!third_party/wiredtiger/include/wiredtiger.h

# ---------------------------------------------------------------- 运行时产物
bench/results/
*.wt
WiredTigerHS*
*.log
# 真 wt / wtperf 的 home 目录文件。脚本都会传 -h，但只要有一次忘了，
# 它们就落在仓库根目录（WiredTiger / .basecfg / .lock / .turtle 都不含 *.wt 后缀，
# 单靠 *.wt 拦不住）。用前导 / 只锚定仓库根，不误伤 docs 里引用的源码路径。
/WiredTiger
/WiredTiger.*

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
*.swp
.DS_Store
